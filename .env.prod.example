DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=43.139.37.150,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://43.139.37.150
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# マイナンバー等の暗号化に使う鍵。変更するとすでに暗号化済みのデータが復号できなくなるので注意。
FIELD_ENCRYPTION_KEY=change-me

# --- P0 アクセス制御（docs/DEPLOY.md「P0 访问控制上线」参照） ---
DJANGO_APP_ENV=production
# 開発用ツール（seed・PDF座標デバッグ）。本番は常に False（True でも APP_ENV=production なら無効）。
DJANGO_ENABLE_DEV_TOOLS=False
# 受保護ダウンロードを nginx の X-Accel-Redirect で送る。
DJANGO_PROTECTED_MEDIA_X_ACCEL=True
# 段階A は False。李を ProtectedAccount に登録・検証後（D5 承認後）に True。
DJANGO_PROTECTED_ADMIN_ENFORCEMENT=False
# localdev 検査：最初は warn。本番で停止/不存在を確認後（D12）に enforce。
DJANGO_LOCALDEV_CHECK_MODE=warn

MYSQL_DATABASE=gyoseishoshi_erp
MYSQL_USER=gyoseishoshi_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306

VITE_BASE_PATH=/sun/
VITE_API_BASE_URL=/sun/api/
